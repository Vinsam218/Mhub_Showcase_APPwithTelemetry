<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:padding="@dimen/mz_pad">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
      <!-- Logo: drop your real logo in res/drawable as mzuriair_logo.png and swap this TextView for an ImageView (fitCenter). -->
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
          android:text="@string/app_name" android:textColor="@color/mz_text" android:textSize="22sp" android:textStyle="bold"/>
      <View android:id="@+id/dot" android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/bg_dot"/>
      <TextView android:id="@+id/tvConn" android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:layout_marginStart="6dp" android:textColor="@color/mz_text2" android:textSize="13sp"/>
      <TextView android:id="@+id/tvTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:layout_marginStart="12dp" android:textColor="@color/mz_text" android:textSize="15sp" android:textStyle="bold"/>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView android:id="@+id/watchFace"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/mz_face" app:cardCornerRadius="@dimen/mz_radius"
        app:cardElevation="4dp" app:strokeWidth="3dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:gravity="center_horizontal" android:orientation="vertical" android:padding="28dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Your Air Quality Index" android:textColor="@color/mz_text2" android:textSize="14sp"/>
        <TextView android:id="@+id/tvRisk" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textSize="32sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvAqi" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/mz_text" android:textSize="64sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Hi! True" android:textColor="@color/mz_text" android:textSize="18sp"/>
        <TextView android:id="@+id/tvMessage" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:gravity="center" android:textColor="@color/mz_text2" android:textSize="15sp"/>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp"
        android:text="CURRENT ENVIRONMENT" android:textColor="@color/mz_accent" android:textSize="12sp" android:textStyle="bold"/>
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" app:cardBackgroundColor="@color/mz_face" app:cardCornerRadius="@dimen/mz_card_radius" app:cardElevation="1dp">
      <LinearLayout android:id="@+id/envList" android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="vertical" android:padding="16dp"/>
    </com.google.android.material.card.MaterialCardView>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp"
        android:text="PHYSIOLOGICAL" android:textColor="@color/mz_accent" android:textSize="12sp" android:textStyle="bold"/>
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" app:cardBackgroundColor="@color/mz_face" app:cardCornerRadius="@dimen/mz_card_radius" app:cardElevation="1dp">
      <LinearLayout android:id="@+id/vitalList" android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="vertical" android:padding="16dp"/>
    </com.google.android.material.card.MaterialCardView>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp"
        android:text="RECOMMENDATIONS" android:textColor="@color/mz_accent" android:textSize="12sp" android:textStyle="bold"/>
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" app:cardBackgroundColor="@color/mz_face" app:cardCornerRadius="@dimen/mz_card_radius" app:cardElevation="1dp">
      <TextView android:id="@+id/tvRecs" android:layout_width="match_parent" android:layout_height="wrap_content"
          android:lineSpacingMultiplier="1.2" android:padding="16dp" android:textColor="@color/mz_text" android:textSize="15sp"/>
    </com.google.android.material.card.MaterialCardView>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp"
        android:text="DEMO SCENARIO" android:textColor="@color/mz_accent" android:textSize="12sp" android:textStyle="bold"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal">
      <com.google.android.material.button.MaterialButton android:id="@+id/btnSafe" style="@style/Widget.Material3.Button.OutlinedButton"
          android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp"
          android:insetTop="0dp" android:insetBottom="0dp" android:text="SAFE" android:textColor="@color/risk_safe"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnModerate" style="@style/Widget.Material3.Button.OutlinedButton"
          android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp"
          android:insetTop="0dp" android:insetBottom="0dp" android:layout_marginStart="8dp" android:text="MODERATE" android:textColor="@color/risk_moderate"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnCritical" style="@style/Widget.Material3.Button.OutlinedButton"
          android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp"
          android:insetTop="0dp" android:insetBottom="0dp" android:layout_marginStart="8dp" android:text="CRITICAL" android:textColor="@color/risk_critical"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:text="@string/demo_note" android:textColor="@color/mz_text2" android:textSize="12sp"/>
  </LinearLayout>
</ScrollView>
