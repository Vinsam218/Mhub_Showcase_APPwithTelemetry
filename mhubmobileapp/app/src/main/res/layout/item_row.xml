<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="40dp" android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@+id/label" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:textColor="@color/mz_text2" android:textSize="14sp"/>
    <TextView android:id="@+id/value" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/mz_text" android:textSize="15sp" android:textStyle="bold"/>
</LinearLayout>
